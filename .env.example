# ─── OrionSentinel Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# Vite exposes VITE_* vars to the frontend bundle.
# Non-prefixed vars are server-side only.

# ── Base RPC (required for real wallet data + lending positions) ──────────────
# Free public fallback: https://mainnet.base.org (rate-limited)
# Recommended: get a free Alchemy key at https://dashboard.alchemy.com/
VITE_BASE_RPC_URL=https://mainnet.base.org

# ── BaseScan API key (improves protocol audit rate limits) ─────────────────────
# Free tier at https://basescan.org/apis
# Without a key, requests are rate-limited to ~1/5 sec
VITE_BASESCAN_API_KEY=

# ── Backend API URL (when running the Express server) ──────────────────────────
# Development default — leave as-is unless you change the port
VITE_BACKEND_URL=http://localhost:3001

# ── Server-side only (not exposed to browser) ─────────────────────────────────
PORT=3001
BASESCAN_API_KEY=
BASE_RPC_URL=https://mainnet.base.org
